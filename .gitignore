# Temporary third-party repo clones (Operit analysis workspace)
.tmp_operit_analysis/

# Locally downloaded offline-plugin SDK archives (about 1.6 GiB).
# Keep manifests, scripts, checksums and download instructions versioned.
assets/plugins/android-suite-offline/payload/archives/

# Locally downloaded QEMU x86_64 user-mode plugin archives (~47 MiB).
# Keep manifests, scripts, checksums and download instructions versioned.
assets/plugins/qemu-x86-64-compat/payload/archives/

# Locally downloaded RTK offline plugin binary (~8.7 MiB) and dist artifacts.
# Keep manifests, scripts, checksums, config and download instructions versioned.
assets/plugins/rtk-suite-offline/payload/bin/
assets/plugins/cc-switch/payload/lib/

# Locally fetched Android CLI binaries for the android-skills plugin (~90 MiB).
# The vendored skills (payload/skills) stay versioned for provenance; the launcher
# and the android-cli payload are reproduced by tools/vendor-android-skills-plugin.py.
assets/plugins/android-skills/payload/bin/
dist/
.workbuddy/
.trae/
.codegraph/
.tmp_unusedscan/
webchat/node_modules/
__pycache__/
*.pyc
webchat/dist/

# 运行时崩溃帧调试产物（不入库）
.crash_frames/

# 临时调试产物与脚本（不入库）
*_tmp/
_*.py
build-output.txt
scripts_patch/

# Harness transient tool/subagent artifacts (may contain project output or logs)
.tianyan-outputs/
.tianyan-subagent/

