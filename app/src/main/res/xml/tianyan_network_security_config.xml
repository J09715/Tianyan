<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        默认拒绝明文（base-config=false）。Android 的 network-security-config 不支持按
        CIDR/通配符放行 192.168.0.0/16，因此局域网明文端点（如 MCP 192.168.*）由各业务
        端点策略单独校验（McpHttpEndpoints 仅允许 localhost/回环与 192.168.*），
        平台层不再为全局明文兜底。
    -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- 仅豁免本机回环：HostBridge 127.0.0.1:7980、沙箱本地 Web 服务、模拟器网关 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
